+
+## Symbols referenced only by relocations in removed sections can be discarded.
+# RUN: llvm-objcopy -x --remove-section=__TEXT,__text %t %t.remove
+# RUN: llvm-readobj --relocations --symbols %t.remove | FileCheck %s --check-prefix=REMOVE
