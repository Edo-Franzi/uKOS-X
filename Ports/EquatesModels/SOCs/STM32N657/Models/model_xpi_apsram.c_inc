// Prototypes

static	void	local_APSRamInitialise(void);
static	void	local_APSRamMappedMode(void);

#if (defined(APSRAM_WRITE_REGISTER))
static	void	local_APSRamWriteRegistar(uint8_t address, uint8_t data);
#endif

#if (defined(APSRAM_READ_REGISTER))
static	void	local_APSRamReadRegistar(uint8_t address, uint8_t *data);
#endif

/*
 * \brief model_xspi_apsram_init
 *
 * - Initialise the manager
 *
 */
void	model_xspi_apsram_init(void) {

	cb_enable();

	local_APSRamInitialise();
	local_APSRamMappedMode();
}

// Local routines
// ==============

/*
 * \brief local_APSRamInitialise
 *
 * - APSRam initialisation
 *
 */
static	void	local_APSRamInitialise(void) {

// Disable the XSPI1 and waiting for not busy

	XSPI_UNIT->CR = 0u;
	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

// Clear the flags

	XSPI_UNIT->FCR = XSPI_FCR_CTOF | XSPI_FCR_CSMF | XSPI_FCR_CTCF | XSPI_FCR_CTEF;

// AP memory of 256-MBytes, CS high time 4 clocks

	XSPI_UNIT->DCR1 = (6u * XSPI_DCR1_MTYP_0)
					| ((25u -1u) * XSPI_DCR1_DEVSIZE_0)
					| (4u * XSPI_DCR1_CSHT_0);

// Wrapper not supported, APSRam clock 200-MHz / 4 = 50-MHz

	XSPI_UNIT->DCR2 = (0u * XSPI_DCR2_WRAPSIZE_0)
					| ((4u - 1u) * XSPI_DCR2_PRESCALER_0);

// Bounds of 2048-Bytes

	XSPI_UNIT->DCR3 = (11u * XSPI_DCR3_CSBOUND_0)
					| (0u * XSPI_DCR3_MAXTRAN_0);

// Refresh: 4us @ 50-MHz
// 4 x 50 = 200

	XSPI_UNIT->DCR4 = (200u * XSPI_DCR4_REFRESH_0);

// Waiting for calibration
	
	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

	XSPI_UNIT->TCR  = (0u * XSPI_TCR_DCYC_0);
	XSPI_UNIT->WTCR = (0u * XSPI_WTCR_DCYC_0);

	XSPI_UNIT->CR = ((4u - 1u) * XSPI_CR_FTHRES_0)
				  | XSPI_CR_EN;

// Set the read latency for 7 to 14 (200-MHz)
// Set the write latency to 7 (200-MHz)
// Switch to x16 mode

	local_APSRamWriteRegistar(0x00, 0x30);
	local_APSRamWriteRegistar(0x04, 0x20);
	local_APSRamWriteRegistar(0x08, 0x40);
}

/*
 * \brief local_APSRamReadRegistar
 *
 * - APSRam read register
 *
 */
#if (defined(APSRAM_READ_REGISTER))
static	void	local_APSRamReadRegistar(uint8_t address, uint8_t *data) {
	uint32_t	value;

// Disable the XSPI1 and waiting for not busy

	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }
	XSPI_UNIT->CR = 0u;
	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

// Clear the flags

	XSPI_UNIT->FCR = XSPI_FCR_CTOF | XSPI_FCR_CSMF | XSPI_FCR_CTCF | XSPI_FCR_CTEF;

// Nb byte of data to read
// Nb dummy cycles
// Frame Format

	XSPI_UNIT->DLR  = 4u - 1u;
	XSPI_UNIT->TCR  = (0u * XSPI_TCR_DCYC_0);
	XSPI_UNIT->WTCR = (0u * XSPI_WTCR_DCYC_0);

	XSPI_UNIT->CCR	= XSPI_CCR_DQSE
					| XSPI_CCR_DDTR								| (4u * XSPI_CCR_DMODE_0)
					| XSPI_CCR_ADDTR | (3u * XSPI_CCR_ADSIZE_0) | (4u * XSPI_CCR_ADMODE_0)
					| XSPI_CCR_IDTR  | (1u * XSPI_CCR_ISIZE_0)  | (4u * XSPI_CCR_IMODE_0);

	XSPI_UNIT->CR = ((4u - 1u) * XSPI_CR_FTHRES_0)
	              | (1u * XSPI_CR_FMODE_0)
	              | XSPI_CR_EN;

// Read register command
// Address = register

	XSPI_UNIT->IR = KAPS_OP_MR_READ<<8u;
	XSPI_UNIT->AR = (uint32_t)address;

// Waiting for Transfer complete

	while ((XSPI_UNIT->SR & XSPI_SR_TCF) == 0u) { ; }
	while ((XSPI_UNIT->SR & XSPI_SR_FTF) == 0u) { ; }

	value = (uint32_t)XSPI_UNIT->DR;
	*data = (uint8_t)(value & 0x000000FFu);
}
#endif

/*
 * \brief local_APSRamWriteRegistar
 *
 * - APSRam write register
 *
 */
#if (defined(APSRAM_WRITE_REGISTER))
static	void	local_APSRamWriteRegistar(uint8_t address, uint8_t data) {

	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

	XSPI_UNIT->CR = XSPI_CR_EN;

// Nb byte of data to read
// Nb dummy cycles
// Frame Format

	XSPI_UNIT->DLR  = (1u - 1u);
	XSPI_UNIT->TCR  = (0u * XSPI_TCR_DCYC_0);
	XSPI_UNIT->WTCR = (0u * XSPI_WTCR_DCYC_0);

// Clear the flags

	XSPI_UNIT->FCR = XSPI_FCR_CTOF | XSPI_FCR_CSMF | XSPI_FCR_CTCF | XSPI_FCR_CTEF;

	XSPI_UNIT->CCR	= XSPI_CCR_DQSE
					| XSPI_CCR_DDTR								| (4u * XSPI_CCR_DMODE_0)
					| XSPI_CCR_ADDTR | (3u * XSPI_CCR_ADSIZE_0) | (4u * XSPI_CCR_ADMODE_0)
					| XSPI_CCR_IDTR  | (1u * XSPI_CCR_ISIZE_0)  | (4u * XSPI_CCR_IMODE_0);

// Write register command
// Address = register

	XSPI_UNIT->IR = KAPS_OP_MR_WRITE<<8u;
	XSPI_UNIT->AR = (uint32_t)address;

// Waiting for not fifo threshold

	while ((XSPI_UNIT->SR & XSPI_SR_FTF)  == 0u) { ; }

// Write the register

	*((volatile uint8_t *)&XSPI_UNIT->DR) = data;

// Waiting for Transfer complete

	while ((XSPI_UNIT->SR & XSPI_SR_TCF)  == 0u) { ; }
	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

	XSPI_UNIT->FCR = XSPI_FCR_CTOF | XSPI_FCR_CSMF | XSPI_FCR_CTCF | XSPI_FCR_CTEF;
}
#endif

/*
 * \brief local_APSRamMappedMode
 *
 * - APSRam in a mapped mode
 *   For this XSPI + APSRam 75-MHz seems to be the limit
 *
 */
static	void	local_APSRamMappedMode(void) {

// Disable the XSPI1 and waiting for not busy

	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }
	XSPI_UNIT->CR = 0u;
	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

// Clear the flags

	XSPI_UNIT->FCR = XSPI_FCR_CTOF | XSPI_FCR_CSMF | XSPI_FCR_CTCF | XSPI_FCR_CTEF;

// AP memory of 256-MBytes, CS high time 4 clocks

	XSPI_UNIT->DCR1 = (6u * XSPI_DCR1_MTYP_0)
					| ((25u -1u) * XSPI_DCR1_DEVSIZE_0)
					| (4u * XSPI_DCR1_CSHT_0);

// Wrapper not supported, APSRam clock 200-MHz / 4 = 50-MHz

	XSPI_UNIT->DCR2 = (0u * XSPI_DCR2_WRAPSIZE_0)
					| ((4u - 1u) * XSPI_DCR2_PRESCALER_0);

// Bounds of 2048-Bytes

	XSPI_UNIT->DCR3 = (11u * XSPI_DCR3_CSBOUND_0)
					| (0u * XSPI_DCR3_MAXTRAN_0);

// Refresh: 4us @ 50-MHz
// 4 x 50 = 200

	XSPI_UNIT->DCR4 = (200u * XSPI_DCR4_REFRESH_0);

// Waiting for calibration
	
	while ((XSPI_UNIT->SR & XSPI_SR_BUSY) != 0u) { ; }

// Nb byte of data to read
// 7 dummy cycles
// Frame Format

	XSPI_UNIT->DLR  = (2u - 1u);
	XSPI_UNIT->TCR  = (7u * XSPI_TCR_DCYC_0);
	XSPI_UNIT->WTCR = (6u * XSPI_WTCR_DCYC_0);

// Linear Burst Read instruction
// Linear Burst wite instruction

	XSPI_UNIT->IR  = (KAPS_OP_LIN_BURST_READ<<8u)  | KAPS_OP_LIN_BURST_READ;
	XSPI_UNIT->WIR = (KAPS_OP_LIN_BURST_WRITE<<8u) | KAPS_OP_LIN_BURST_WRITE;

// Memory-mapped mode

	XSPI_UNIT->CCR	= XSPI_CCR_DQSE
					| XSPI_CCR_DDTR								  | (5u * XSPI_CCR_DMODE_0)
					| XSPI_CCR_ADDTR  | (3u * XSPI_CCR_ADSIZE_0)  | (4u * XSPI_CCR_ADMODE_0)
					| XSPI_CCR_IDTR   | (1u * XSPI_CCR_ISIZE_0)   | (4u * XSPI_CCR_IMODE_0);

	XSPI_UNIT->WCCR	= XSPI_WCCR_DQSE
					| XSPI_WCCR_DDTR							  | (5u * XSPI_WCCR_DMODE_0)
					| XSPI_WCCR_ADDTR | (3u * XSPI_WCCR_ADSIZE_0) | (4u * XSPI_CCR_ADMODE_0)
					| XSPI_WCCR_IDTR  | (1u * XSPI_WCCR_ISIZE_0)  | (4u * XSPI_CCR_IMODE_0);

	XSPI_UNIT->HLCR = 0x00000000u;

// Clear the flags

	XSPI_UNIT->FCR = XSPI_FCR_CTOF | XSPI_FCR_CSMF | XSPI_FCR_CTCF | XSPI_FCR_CTEF;

	XSPI_UNIT->CR = ((4u - 1u) * XSPI_CR_FTHRES_0)
				  | (3u * XSPI_CR_FMODE_0)
				  | XSPI_CR_EN;

	STRONG_BARRIER;
}
