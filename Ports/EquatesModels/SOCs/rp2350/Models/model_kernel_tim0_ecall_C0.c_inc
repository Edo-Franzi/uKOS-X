#include	"Registers/RP2350_resets.h"
#include	"Registers/RP2350_timer.h"
#include	"Registers/nvic.h"
#include	"clockTree.h"
#include	"exce.h"
#include	"macros_core_stackFrame.h"
#include	"kern/private/private_processes.h"
#include	"kern/private/private_scheduler.h"
#include	"kern/private/private_temporal.h"

#define K1ms_C0			((float64_t)(0.001))

#define KTIC_DELTA_C0	((uint32_t)(KFREQUENCY_TIM * KKERN_TIC_TIME	 * K1ms_C0))		// 1-ms tick
#define KTOUT_DELTA_C0	((uint32_t)(KFREQUENCY_TIM * KKERN_PROC_TIMEOUT * K1ms_C0))		// 20-ms quota

static	volatile	uint32_t	vTimeStart_C0	  = 0u;
static	volatile	uint32_t	vTimeStop_C0	  = 0u;
static	volatile	uint32_t	vTimeLastStart_C0 = 0u;
static	volatile	uint64_t	vTickCount_C0	  = 0u;

// External: set/restored by first_handle_trap ecall path (per-hart arrays).

extern	volatile	uintptr_t	vSaveStack[KNB_CORES];
extern	volatile	uint32_t	vMessage[KNB_CORES];

// Prototypes

static	void	local_TIM0_ALA0_IRQHandler_C0(void);
static	void	local_TIM0_ALA1_IRQHandler_C0(void);
static	void	local_timeStmp_C0(bool overflow);
static	void	local_timeStart_C0(void);
static	void	local_timeStop_C0(void);

/*
 * \brief model_kernel_init_C0
 *
 * - Reset TIMER0, register interrupt vectors, set priorities, arm both alarms.
 *
 */
static	void	model_kernel_init_C0(void) {

	REG(RESETS)->RESET &= ~RESETS_RESET_TIMER0;
	while ((REG(RESETS)->RESET_DONE & RESETS_RESET_TIMER0) != RESETS_RESET_TIMER0) { ; }

	TIMER_C0->INTR = 0xFFFFFFFFu;

	INTERRUPT_VECTOR(TIMER_ALA0_VECTOR_NUMBER_C0, local_TIM0_ALA0_IRQHandler_C0);
	INTERRUPT_VECTOR(TIMER_ALA1_VECTOR_NUMBER_C0, local_TIM0_ALA1_IRQHandler_C0);

	h3irq_SetPriority(TIMER_ALA0_VECTOR_NUMBER_C0, KINT_LEVEL_KERNEL_TIMERS);
	h3irq_SetPriority(TIMER_ALA1_VECTOR_NUMBER_C0, KINT_LEVEL_KERNEL_TIMERS);

	TIMER_C0->ALARM0 = TIMER_C0->TIMERAWL + KTIC_DELTA_C0;
	TIMER_C0->ALARM1 = TIMER_C0->TIMERAWL + KTOUT_DELTA_C0;
}

/*
 * \brief model_kernel_runKernel_C0
 *
 * - Enable and arm both timer alarms; reset the 64-bit tick counter.
 *
 */
static	void	model_kernel_runKernel_C0(void) {

	TIMER_C0->INTE = TIMER_C0->INTE | TIMER_INTE_ALARM_0;
	TIMER_C0->INTE = TIMER_C0->INTE | TIMER_INTE_ALARM_1;

	h3irq_ClearPendingIRQ(TIMER_ALA0_VECTOR_NUMBER_C0);
	h3irq_ClearPendingIRQ(TIMER_ALA1_VECTOR_NUMBER_C0);

	h3irq_EnableIRQ(TIMER_ALA0_VECTOR_NUMBER_C0);
	h3irq_EnableIRQ(TIMER_ALA1_VECTOR_NUMBER_C0);

// Enable Machine External Interrupt in mie CSR so Hazard3 routes
// MEIEA-enabled peripheral IRQs to the core (mcause 11 path).
// h3irq_EnableIRQ only sets the MEIEA peripheral-enable bit; MIE_MEIE
// is the second gate and must be set separately.

	core_setBitCSR(RV_CSR_MIE, MIE_MEIE);

	vTickCount_C0 = 0u;
}

/*
 * \brief model_kernel_setLowPower_C0
 *
 * - Set the low power mode
 *
 * KKERN_CPU_MODE_NORMAL		-> Normal mode
 * KKERN_CPU_MODE_DEEP_SLEEP	-> CPU in a deep sleep mode
 * KKERN_CPU_MODE_HIBERNATE		-> CPU in a hibernate mode
 * KKERN_CPU_MODE_STOP			-> CPU in a stop mode
 *
 */
static	void	model_kernel_setLowPower_C0(uint8_t mode) {

	switch (mode) {
		case KKERN_CPU_MODE_NORMAL:
		case KKERN_CPU_MODE_DEEP_SLEEP:
		case KKERN_CPU_MODE_HIBERNATE:
		case KKERN_CPU_MODE_STOP:
		default: {
			WAITING_INTERRUPTION;
			break;
		}
	}
}

/*
 * \brief model_kernel_readTickCount_C0
 *
 * - Return the 64-bit 1-us tick counter.
 *
 */
static	void	model_kernel_readTickCount_C0(uint64_t *tickCount) {

	INTERRUPTION_OFF;
	local_timeStmp_C0(false);
	*tickCount = vTickCount_C0;
	INTERRUPTION_RESTORE;
}

/*
 * \brief model_kernel_newProcessTimeout_C0
 *
 * - Arm ALARM1 for the next process's 20-ms quota.
 *
 */
static	void	model_kernel_newProcessTimeout_C0(void) {

	TIMER_C0->INTE = TIMER_C0->INTE & (uint32_t)~TIMER_INTE_ALARM_1;
	TIMER_C0->INTR = TIMER_INTR_ALARM_1;

	h3irq_ClearPendingIRQ(TIMER_ALA1_VECTOR_NUMBER_C0);
	h3irq_EnableIRQ(TIMER_ALA1_VECTOR_NUMBER_C0);

	TIMER_C0->ALARM1 = TIMER_C0->TIMERAWL + KTOUT_DELTA_C0;
	TIMER_C0->INTE	 = TIMER_C0->INTE | TIMER_INTE_ALARM_1;
}

/*
 * \brief model_kernel_stopProcessTimeout_C0
 *
 * - Stop the process timeout
 *
 */
static	void	model_kernel_stopProcessTimeout_C0(void) {

	h3irq_DisableIRQ(TIMER_ALA1_VECTOR_NUMBER_C0);
}

// Local routines
// ==============

/*
 * \brief local_TIM0_ALA0_IRQHandler_C0
 *
 * - Fine time interruption
 * - Verify the timeout condition of the suspended processes
 *
 */
static	void	local_TIM0_ALA0_IRQHandler_C0(void) {

	TIMER_C0->INTR	 = TIMER_INTR_ALARM_0;
	TIMER_C0->ALARM0 = TIMER_C0->TIMERAWL + KTIC_DELTA_C0;

	local_timeStmp_C0(false);

// Guard: only call scheduler if at least one process has been installed.
// local_updateDynaPriority() dereferences oFirst which is nullptr until
// the first process is connected to the execution list.

	if (vKern_listExec[GET_RUNNING_CORE].oNbElements > 0u) {
		scheduler_callBackFast(1u);
	}
}

/*
 * \brief local_TIM0_ALA1_IRQHandler_C0
 *
 * - 20-ms quota expiry: acknowledge and disarm.
 *	 Preemptive context switch from interrupt context requires saving the full
 *	 35-word process frame; that work is deferred to Phase 3.4. For Phase 3.3,
 *	 the process runs until it makes the next kernel call (SET_MESSAGE/ecall).
 *
 */
static	void	local_TIM0_ALA1_IRQHandler_C0(void) {

	TIMER_C0->INTE = TIMER_C0->INTE & (uint32_t)~TIMER_INTE_ALARM_1;
	TIMER_C0->INTR = TIMER_INTR_ALARM_1;
	h3irq_ClearPendingIRQ(TIMER_ALA1_VECTOR_NUMBER_C0);
}

/*
 * \brief kernel_message_C0
 *
 * - ecall-based context switch for Core 0.
 *	 Called from syscallDispatcher (exception vector slot 11) after
 *	 first_handle_trap has:
 *	   1. saved the full 28-word process frame (16 caller-saved + 12 callee-saved)
 *	   2. stored a0 (the kernel message) in vMessage
 *	   3. stored sp in vSaveStack
 *
 * - On return, first_handle_trap reads the new vSaveStack (updated by the
 *	 scheduler) and restores the next process's context before executing mret.
 *
 */
void	kernel_message_C0(void) {

	vKern_stackProc[KCORE_0] = (uintptr_t *)vSaveStack[KCORE_0];
	vPriv_insideSVC[KCORE_0] = true;

	local_timeStop_C0();

	INTERRUPTION_SET_PERIPH;

	CHECK_STACK_SANITY(KCORE_0);

	scheduler_callBackTrap(vMessage[KCORE_0]);
	local_timeStart_C0();

	vSaveStack[KCORE_0] = (uintptr_t)vKern_stackProc[KCORE_0];

// Statistics

	#if (KKERN_WITH_STATISTICS_S == true)
	INTERRUPTION_OFF;
	const	uint32_t	timeStart = vTimeStart_C0;
	const	uint32_t	timeStop  = vTimeStop_C0;
	const	uint32_t	timeLast  = vTimeLastStart_C0;
	const	uint32_t	tExc	  = vKern_TimeException[KCORE_0];
			proc_t		*proc	  = vKern_backwardProc[KCORE_0];
	INTERRUPTION_RESTORE;

	statistics_statistic(proc, timeStart, timeStop, timeLast, tExc);
	vKern_TimeException[KCORE_0] = 0u;
	#endif

	vPriv_insideSVC[KCORE_0] = false;
}

/*
 * \brief local_timeStart_C0
 *
 * - Give a new time-stamp (1-us of resolution)
 *   - 0x00000000 to 0xFFFFFFFF incremental counter
 *
 */
static	void	local_timeStart_C0(void) {

	INTERRUPTION_OFF;
	vTimeLastStart_C0 = vTimeStart_C0;
	vTimeStart_C0	  = TIMER_C0->TIMERAWL;
	INTERRUPTION_RESTORE;
}

/*
 * \brief local_timeStop_C0
 *
 * - Give a new time-stamp (1-us of resolution)
 *   - 0x00000000 to 0xFFFFFFFF incremental counter
 *
 */
static	void	local_timeStop_C0(void) {

	INTERRUPTION_OFF;
	vTimeStop_C0 = TIMER_C0->TIMERAWL;
	INTERRUPTION_RESTORE;
}

/*
 * \brief local_timeStmp_C0
 *
 * - Maintain a 64-bit timer with 1-us of resolution
 *
 */
static	void	local_timeStmp_C0(bool overflow) {
	uint32_t	newTime;

	INTERRUPTION_OFF;
	newTime = TIMER_C0->TIMERAWL;

	if (overflow) {
		vTickCount_C0 = (vTickCount_C0 & 0xFFFFFFFF00000000u) + 0x100000000u;
		INTERRUPTION_RESTORE;
		return;
	}

	if (newTime > 0u) {
		vTickCount_C0 = (vTickCount_C0 & 0xFFFFFFFF00000000u) | newTime;
	}
	INTERRUPTION_RESTORE;
}
